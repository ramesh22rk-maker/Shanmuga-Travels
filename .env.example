# ==========================================
# Shanmuga Travels - Environment Variables
# ==========================================

# Supabase Project URL (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (from Supabase Project Settings -> API)
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Optional: Supabase Service Role Key (for administrative backend access)
SUPABASE_SERVICE_ROLE_KEY=

# Server Port (for local Node.js server)
PORT=3000
